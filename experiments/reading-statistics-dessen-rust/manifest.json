{
  "id": "reading-statistics",
  "title": "Reading Statistics",
  "description": "Reading statistics, device-code pairing and optional server refresh",
  "version": "0.1.15",
  "permissions": {
    "filesystem": {
      "app_directory": ["read", "write", "delete", "list"],
      "read": ["/.crosspoint/reading_sessions.jsonl", "/Books/**", "/sleep.bmp", "/sleep-backup.bmp"],
      "write": ["/sleep.bmp", "/sleep-backup.bmp"],
      "delete": ["/sleep.bmp", "/sleep-backup.bmp"]
    },
    "library": true,
    "credentials": {
      "shared": ["/.crosspoint/reading-statistics-token.json"]
    },
    "network": {
      "origins": ["https://sync.techy-notes.com"],
      "handoff": true
    }
  },
  "optional_permissions": {
    "device_identity": true,
    "history_identity": true
  }
}
